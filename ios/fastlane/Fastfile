# Game Box — fastlane lanes. Optional, but turns TestFlight into one command:
#   cd ios && fastlane beta
# Requires: `gem install fastlane` (or `brew install fastlane`) and an App Store Connect API key
# (App Store Connect ▸ Users and Access ▸ Integrations ▸ App Store Connect API). Export:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (the .p8 file)
default_platform(:ios)

platform :ios do
  desc "Build and upload a TestFlight build"
  lane :beta do
    api_key = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_filepath: ENV["ASC_KEY_PATH"])
    team = ENV["GAMEBOX_TEAM_ID"] or UI.user_error!("Set GAMEBOX_TEAM_ID to your 10-character Apple Team ID (developer.apple.com ▸ Membership)")
    sh("GAMEBOX_NO_OPEN=1 bash ../bootstrap.sh --team #{team}")   # fresh web build + project, signed for your team
    increment_build_number(xcodeproj: "GameBox.xcodeproj", build_number: Time.now.strftime("%Y%m%d%H%M"))
    build_app(project: "GameBox.xcodeproj", scheme: "GameBox", export_method: "app-store", xcargs: "-allowProvisioningUpdates")
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Build and upload an App Store release candidate (refuses Google's test ad IDs)"
  lane :release do
    yml = File.read("../project.yml")
    if yml.include?("3940256099942544")
      UI.user_error!("project.yml still has Google's TEST AdMob IDs. Put your real GADApplicationIdentifier and GADRewardedUnitID in ios/project.yml (AdMob ▸ Apps ▸ Game Box) before releasing.")
    end
    api_key = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_filepath: ENV["ASC_KEY_PATH"])
    team = ENV["GAMEBOX_TEAM_ID"] or UI.user_error!("Set GAMEBOX_TEAM_ID to your 10-character Apple Team ID")
    sh("GAMEBOX_NO_OPEN=1 bash ../bootstrap.sh --team #{team}")
    increment_build_number(xcodeproj: "GameBox.xcodeproj", build_number: Time.now.strftime("%Y%m%d%H%M"))
    build_app(project: "GameBox.xcodeproj", scheme: "GameBox", export_method: "app-store", xcargs: "-allowProvisioningUpdates")
    upload_to_app_store(api_key: api_key, skip_metadata: true, skip_screenshots: true, submit_for_review: false, precheck_include_in_app_purchases: false)
  end
end
